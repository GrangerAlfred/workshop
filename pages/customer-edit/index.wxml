<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:else class="form">
    <view class="field">
      <text class="label">客户名称</text>
      <input class="input" value="{{form.name}}" data-field="name" bindinput="onFieldInput" placeholder="必填" />
    </view>
    <view class="field">
      <text class="label">客户类型</text>
      <picker range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-value">{{typeOptions[typeIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">联系人</text>
      <input class="input" value="{{form.contactName}}" data-field="contactName" bindinput="onFieldInput" />
    </view>
    <view class="field">
      <text class="label">电话</text>
      <input class="input" value="{{form.phone}}" data-field="phone" bindinput="onFieldInput" type="number" />
    </view>
    <view class="field">
      <text class="label">微信</text>
      <input class="input" value="{{form.wechat}}" data-field="wechat" bindinput="onFieldInput" />
    </view>
    <view class="field">
      <text class="label">地址</text>
      <input class="input" value="{{form.address}}" data-field="address" bindinput="onFieldInput" />
    </view>
    <view class="field textarea-field">
      <text class="label">备注</text>
      <textarea class="textarea" value="{{form.note}}" data-field="note" bindinput="onFieldInput" />
    </view>
    <button class="save-button" loading="{{saving}}" bindtap="save">保存</button>
  </view>
</view>
