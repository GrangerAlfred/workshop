page {
  min-height: 100vh;
  background: #f4f6f8;
}

.page {
  height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 32rpx 0 24rpx;
}

.eyebrow {
  color: #7a8699;
  font-size: 22rpx;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.subtitle {
  margin-top: 10rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 36rpx;
}

.profile-button {
  width: 128rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  line-height: 64rpx;
  background: #ffffff;
  color: #344054;
  font-size: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.06);
}

.notice {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 8rpx;
  background: #fff1f0;
  color: #a8071a;
  font-size: 26rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.stat-cell {
  width: 336rpx;
  min-height: 144rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 18rpx rgba(31, 41, 55, 0.05);
}

.stat-cell.wide {
  width: 100%;
}

.stat-value {
  display: block;
  color: #172033;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.stat-value.money {
  font-size: 40rpx;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.section-title {
  margin: 36rpx 0 16rpx;
  color: #344054;
  font-size: 28rpx;
  font-weight: 600;
}

.actions {
  padding-bottom: 40rpx;
}

.action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 28rpx 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 18rpx rgba(31, 41, 55, 0.05);
}

.action-main {
  flex: 1;
}

.action-title {
  display: block;
  color: #172033;
  font-size: 32rpx;
  font-weight: 600;
}

.action-desc {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
}

.action-arrow {
  color: #98a2b3;
  font-size: 52rpx;
  line-height: 52rpx;
}
