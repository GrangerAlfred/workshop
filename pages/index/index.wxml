<scroll-view class="page" scroll-y>
  <view class="hero">
    <view>
      <text class="eyebrow">WORKSHOP</text>
      <view class="title">陶瓷工坊</view>
      <view class="subtitle">客户、素胚和基础资料先稳稳管起来</view>
    </view>
    <button class="profile-button" bindtap="goProfile">账号</button>
  </view>

  <view wx:if="{{errorMessage}}" class="notice">{{errorMessage}}</view>

  <view class="stats-grid">
    <view class="stat-cell">
      <text class="stat-value">{{stats.customerCount}}</text>
      <text class="stat-label">客户档案</text>
    </view>
    <view class="stat-cell">
      <text class="stat-value">{{stats.bisqueCount}}</text>
      <text class="stat-label">素胚种类</text>
    </view>
    <view class="stat-cell">
      <text class="stat-value">{{stats.lowStockCount}}</text>
      <text class="stat-label">库存提醒</text>
    </view>
    <view class="stat-cell wide">
      <text class="stat-value money">{{stats.unpaidAmountText}}</text>
      <text class="stat-label">客户欠款</text>
    </view>
  </view>

  <view class="section-title">常用入口</view>
  <view class="actions">
    <view class="action-card" bindtap="goCustomers">
      <view class="action-main">
        <text class="action-title">客户管理</text>
        <text class="action-desc">联系人、欠款、偏好备注</text>
      </view>
      <text class="action-arrow">›</text>
    </view>
    <view class="action-card" bindtap="goInventory">
      <view class="action-main">
        <text class="action-title">素胚库存</text>
        <text class="action-desc">规格、库存、成本、预警</text>
      </view>
      <text class="action-arrow">›</text>
    </view>
  </view>
</scroll-view>
