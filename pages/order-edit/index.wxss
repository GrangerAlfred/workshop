page {
  min-height: 100vh;
  background: #f4f6f8;
}

.page {
  height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.page-head {
  padding: 12rpx 0 24rpx;
}

.page-title {
  color: #172033;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
}

.form-card,
.summary-card {
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 18rpx rgba(31, 41, 55, 0.05);
}

.form-card {
  padding: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #eef1f4;
}

.field:last-child {
  border-bottom: 0;
}

.picker-field {
  align-items: flex-start;
  padding: 18rpx 0;
}

.textarea-field {
  align-items: flex-start;
  padding: 24rpx 0 0;
}

.label {
  flex: 0 0 180rpx;
  color: #667085;
  font-size: 28rpx;
}

.input,
.picker-value {
  flex: 1;
  min-height: 96rpx;
  line-height: 96rpx;
  color: #172033;
  font-size: 30rpx;
}

picker,
.picker-wrap {
  flex: 1;
}

.hint {
  padding: 12rpx 0 0 180rpx;
  color: #667085;
  font-size: 25rpx;
}

.textarea {
  flex: 1;
  min-height: 160rpx;
  color: #172033;
  font-size: 30rpx;
}

.summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
}

.summary-label {
  display: block;
  color: #667085;
  font-size: 24rpx;
}

.summary-value {
  display: block;
  margin-top: 6rpx;
  color: #172033;
  font-size: 40rpx;
  font-weight: 700;
}

.save-button {
  width: 200rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  line-height: 72rpx;
  background: #1f6feb;
  color: #ffffff;
  font-size: 28rpx;
}
